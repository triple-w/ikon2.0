# Environment and local secrets
.env
.env.*
!.env.example
app/Config/Local.php
app/Config/*Local.php
*.secret
*.secrets

# Runtime data
writable/cache/**
writable/logs/**
writable/session/**
writable/uploads/**
writable/debugbar/**
writable/backups/**
writable/reports/**
writable/releases/**
writable/*.php
writable/fiscal-private/**
writable/fiscal/prexml/**
writable/fiscal/certificates/**
writable/fiscal/artifacts/**
writable/fiscal/pac-contingency/**

# Runtime-generated temporary documents; keep the access-control sentinel.
/files/temp/*
!/files/temp/index.html
!writable/cache/.gitkeep
!writable/logs/.gitkeep
!writable/session/.gitkeep

# Fiscal and cryptographic material
*.cer
*.key
*.pem
*.pfx
*.p12
*.jks

# Temporary and editor files
*.tmp
*.temp
*.bak
*.swp
~$*
.DS_Store
Thumbs.db
/*.sql
.build-check/
public/soap-check.php
.idea/
.vscode/

# Test output
.phpunit.cache/
.phpunit.result.cache
coverage/
